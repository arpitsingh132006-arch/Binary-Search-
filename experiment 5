#include <iostream>
#include <vector>
#include <climits>
using namespace std;

void primMST(const vector<vector<int>>& graph, int V) {
    vector<int> key(V, INT_MAX);
    vector<int> parent(V, -1);
    vector<bool> inMST(V, false);

    // Start from vertex 0
    key[0] = 0;

    for (int count = 0; count < V - 1; count++) {

        // Find the vertex with minimum key value
        int u = -1;
        int minKey = INT_MAX;

        for (int v = 0; v < V; v++) {
            if (!inMST[v] && key[v] < minKey) {
                minKey = key[v];
                u = v;
            }
        }

        // Include vertex u in MST
        inMST[u] = true;

        // Update key values of adjacent vertices
        for (int v = 0; v < V; v++) {
            if (graph[u][v] != 0 &&
                !inMST[v] &&
                graph[u][v] < key[v]) {

                key[v] = graph[u][v];
                parent[v] = u;
            }
        }
    }

    cout << "Edges in Minimum Spanning Tree:\n";
    int totalWeight = 0;

    for (int v = 1; v < V; v++) {
        cout << parent[v] << " - " << v
             << " : " << graph[parent[v]][v] << endl;

        totalWeight += graph[parent[v]][v];
    }

    cout << "Total MST Weight = " << totalWeight << endl;
}

int main() {
    int V = 5;

    vector<vector<int>> graph = {
        {0, 2, 0, 6, 0},
        {2, 0, 3, 8, 5},
        {0, 3, 0, 0, 7},
        {6, 8, 0, 0, 9},
        {0, 5, 7, 9, 0}
    };

    primMST(graph, V);

    return 0;
}

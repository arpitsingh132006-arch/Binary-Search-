#include <iostream>
#include <climits>
using namespace std;
#define V 5
int main() {
    int g[V][V] = {
        {0,10,0,5,0},
        {10,0,1,2,0},
        {0,1,0,0,4},
        {5,2,0,0,2},
        {0,0,4,2,0}
    };
    int d[V], visited[V] = {0};
    for(int i=0;i<V;i++)
        d[i] = INT_MAX;
    d[0] = 0;
    for(int i=0;i<V-1;i++) {
        int u=-1;
        for(int j=0;j<V;j++)
            if(!visited[j] && (u==-1 || d[j]<d[u]))
                u=j;
        visited[u] = 1;
        for(int v=0;v<V;v++)
            if(g[u][v] && d[u]!=INT_MAX &&
               d[u]+g[u][v]<d[v])
                d[v]=d[u]+g[u][v];
    }
    cout << "Shortest distances from source 0:\n";
    for(int i=0;i<V;i++)
        cout << "0 -> " << i << " = " << d[i] << endl;
    return 0;
}

#include <bits/stdc++.h>
using namespace std;

// Merge two sorted parts
void mergeArray(vector<int> &arr, int low, int mid, int high) {
    vector<int> temp;

    int i = low;
    int j = mid + 1;

    // Compare elements from both parts
    while (i <= mid && j <= high) {
        if (arr[i] <= arr[j]) {
            temp.push_back(arr[i]);
            i++;
        } else {
            temp.push_back(arr[j]);
            j++;
        }
    }

    // Copy remaining elements from left part
    while (i <= mid) {
        temp.push_back(arr[i]);
        i++;
    }

    // Copy remaining elements from right part
    while (j <= high) {
        temp.push_back(arr[j]);
        j++;
    }

    // Copy sorted elements back to original array
    for (int k = 0; k < temp.size(); k++) {
        arr[low + k] = temp[k];
    }
}


// Merge Sort function
void mergeSort(vector<int> &arr, int low, int high) {
    if (low < high) {
        int mid = low + (high - low) / 2;

        // Sort left half
        mergeSort(arr, low, mid);

        // Sort right half
        mergeSort(arr, mid + 1, high);

        // Merge both halves
        mergeArray(arr, low, mid, high);
    }
}


// Print the array
void printArray(vector<int> &arr) {
    for (int &val : arr) {
        cout << val << " ";
    }
    cout << endl;
}


int main() {
    int n;

    // Take array size from user
    cout << "Enter the size of the array: ";
    cin >> n;

    vector<int> arr(n);

    // Take array elements from user
    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Original array
    cout << "\nOriginal array: ";
    printArray(arr);

    // Apply Merge Sort
    mergeSort(arr, 0, n - 1);

    // Sorted array
    cout << "Sorted array: ";
    printArray(arr);


    // Complexity Output
    cout << "\nTime Complexity:" << endl;
    cout << "Best Case    : O(n log n)" << endl;
    cout << "Average Case : O(n log n)" << endl;
    cout << "Worst Case   : O(n log n)" << endl;

    cout << "\nSpace Complexity:" << endl;
    cout << "Best Case    : O(n)" << endl;
    cout << "Average Case : O(n)" << endl;
    cout << "Worst Case   : O(n)" << endl;

    return 0;
}
